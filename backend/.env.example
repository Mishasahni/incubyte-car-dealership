# Copy to backend/.env (git-ignored) and fill in real values. Never commit .env.

# Development database (used by the running app and scripts).
DATABASE_URL=postgresql+psycopg://car_dealership_app:CHANGE_ME@localhost:5432/car_dealership

# Test database (used only by pytest). Its name must end in "_test".
TEST_DATABASE_URL=postgresql+psycopg://car_dealership_app:CHANGE_ME@localhost:5432/car_dealership_test

# Secret used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# Optional overrides (defaults shown).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
# Browser origins allowed to call the API, as a JSON list.
# CORS_ORIGINS=["http://localhost:5173"]

# One-click demo access for evaluators (off by default). Create the two dedicated accounts
# with `python -m scripts.create_demo_accounts`, then set DEMO_ACCESS_ENABLED=true.
# Use dedicated demo accounts only, never personal ones, and keep the passwords out of git.
# DEMO_ACCESS_ENABLED=false
# DEMO_BUYER_EMAIL=
# DEMO_BUYER_PASSWORD=
# DEMO_ADMIN_EMAIL=
# DEMO_ADMIN_PASSWORD=
