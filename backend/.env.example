# Copy to backend/.env (git-ignored) and fill in real values. Never commit .env.

# Development database (used by the running app and scripts).
DATABASE_URL=postgresql+psycopg://car_dealership_app:CHANGE_ME@localhost:5432/car_dealership

# Test database (used only by pytest). Its name must end in "_test".
TEST_DATABASE_URL=postgresql+psycopg://car_dealership_app:CHANGE_ME@localhost:5432/car_dealership_test

# Secret used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME

# Optional overrides (defaults shown).
# ACCESS_TOKEN_EXPIRE_MINUTES=60
